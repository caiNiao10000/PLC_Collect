<Project>
  <!--
    全局目标框架断言。Directory.Build.props 只提供默认值，而项目自身的 csproj
    里的 <TargetFramework> 会覆盖它 —— 于是任何新项目（dotnet new 模板默认就会
    写出显式 TargetFramework）在自身 csproj 里钉死 net10 都能绕过探针测试。
    本文件在属性求值完成后执行，对所有项目生效，从机制上堵住这个逃逸。
  -->
  <!--
    挂钩点说明：挂在 PrepareForBuild 而不是 Build 上。
    BeforeTargets="Build" 实测晚于 CoreCompile —— 编译器会先跑，于是：
      (a) 逃逸产物（bin/obj 下的 net10 / win-x86 目录）已经落盘；
      (b) RID 被改成 win-x86 时，编译器会先报一个语焉不详的
          "CSC : error CS8012: 引用程序集...面向的是另一个处理器"，
          而本护栏的明确错误（PLCDH001）根本轮不到报出。
    PrepareForBuild 是 Build 链上 CoreCompile 之前的早期目标，挂在这里可以
    在编译发生前就拦下，两个问题一并解决。
  -->
  <Target Name="EnforcePlcDataHubTargetFramework" BeforeTargets="PrepareForBuild;Build"
          Condition="('$(TargetFramework)' != '' and '$(TargetFramework)' != 'net8.0-windows')
                     or ('$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64')
                     or ('$(RuntimeIdentifiers)' != '' and '$(RuntimeIdentifiers)' != 'win-x64')">

    <!-- ===== 情形一：TFM 本身违规 =====
         该 TFM 下所有产物都不可信（可能是 net9/net10 的），删整棵。
         显式写 '$(TargetFramework)' != 'net8.0-windows'，确保与情形二互斥、不重复删除。 -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' != '' and '$(TargetFramework)' != 'net8.0-windows'" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' != '' and '$(TargetFramework)' != 'net8.0-windows'" />

    <!-- ===== 情形二：TFM 合规、仅 RID 违规 =====
         只删该 RID 这一层，保留同一 TFM 下本来有效的 win-x64 产物。
         （修复轮 2 的写法在此处会连带删掉合规的 win-x64 产物，是错的。） -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' == 'net8.0-windows' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' == 'net8.0-windows' and '$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'" />

    <!--
      以下两条（复数 RuntimeIdentifiers 路径）是【惰性】的，不承担拦截职责：
      ① RuntimeIdentifiers 是分号分隔的列表，而 RemoveDir 的每个路径是单个目录、不按分号拆分；
      ② 产物目录命名用的是单数 $(RuntimeIdentifier)，复数属性从不参与目录命名。
      真正承重的是本目标的 Condition 里的复数守卫（它负责报错）。
      保留这两条是对"将来有人改用复数属性命名产物目录"的零成本防御 —— 请勿据此认为
      Condition 里的守卫可以删除。
    -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifiers)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' == 'net8.0-windows' and '$(RuntimeIdentifiers)' != '' and '$(RuntimeIdentifiers)' != 'win-x64'" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifiers)"
               Condition="'$(Configuration)' != '' and '$(TargetFramework)' == 'net8.0-windows' and '$(RuntimeIdentifiers)' != '' and '$(RuntimeIdentifiers)' != 'win-x64'" />

    <!-- ===== 报错 =====
         条件里加了 '$(Configuration)' != '' 守卫，避免 Configuration 为空时
         路径塌缩成 bin\\ 这类过宽的删除路径。 -->
    <Error Code="PLCDH001"
           Condition="'$(Configuration)' != ''"
           Text="目标平台违规：项目 $(MSBuildProjectFile) 的 TargetFramework='$(TargetFramework)'、RuntimeIdentifier='$(RuntimeIdentifier)'、RuntimeIdentifiers='$(RuntimeIdentifiers)'，但本项目必须为 TFM=net8.0-windows 且 RID=win-x64。请对照上面三项实际值，删除该 csproj 里私自覆盖的 &lt;TargetFramework&gt; / &lt;RuntimeIdentifier&gt; / &lt;RuntimeIdentifiers&gt; 行，由 Directory.Build.props 统一提供。原因：.NET 9/10 已放弃 Windows 10 支持、现场工控机大量为 Windows 10；32 位进程有约 2GB 内存上限。" />
    <!-- Configuration 为空属于异常场景（无输出路径可清理，也不应报路径相关的错），
         但仍需拦下违规，退化为不含清理的报错。 -->
    <Error Code="PLCDH001"
           Condition="'$(Configuration)' == ''"
           Text="目标平台违规：项目 $(MSBuildProjectFile) 的 TargetFramework='$(TargetFramework)'、RuntimeIdentifier='$(RuntimeIdentifier)'、RuntimeIdentifiers='$(RuntimeIdentifiers)'，但本项目必须为 TFM=net8.0-windows 且 RID=win-x64。请删除该 csproj 里私自覆盖的 &lt;TargetFramework&gt; / &lt;RuntimeIdentifier&gt; / &lt;RuntimeIdentifiers&gt; 行，由 Directory.Build.props 统一提供。" />
  </Target>

  <Target Name="EnforcePlcDataHubTargetFrameworks" BeforeTargets="Build"
          Condition="'$(TargetFrameworks)' != ''">
    <Error Code="PLCDH002"
           Text="目标框架违规：项目 $(MSBuildProjectFile) 使用了多目标 '$(TargetFrameworks)'。本项目只允许单一目标 net8.0-windows。" />
  </Target>
</Project>
