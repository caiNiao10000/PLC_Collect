<Project Sdk="Microsoft.NET.Sdk">
  <!-- 刻意不写 TargetFramework：由 Directory.Build.props 统一提供 -->
  <PropertyGroup>
    <RootNamespace>PlcDataHub.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--
      必须排除 tests 子目录。SDK 风格项目默认把目录树下的所有 .cs 都编译进来，
      如果测试项目建在本项目的子目录里，测试源码会被编进类库并报
      "未能找到类型或命名空间名 Xunit" —— 而且错误会指向类库，极难排查。
      本机已实测踩到这个坑。见 Task 6 / Task 8 的模板生成命令。
    -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!--
      汉字转拼音（全拼）。规格 3.5 节要求中文列名转全拼，故必须用 Pinyin 包。
      ⚠️ 不要换成 ToolGood.Words.FirstPinyin：那个包是"拼音首字母"库，
         GetFirstPinyin("温度") 返回 "WD" 而非 "wen_du"，无法满足规格 3.5 节。
         本机已实测确认（见 task-3-report.md 的拼音库实测小节）。
      实测 API（3.0.1.4）：ToolGood.Words.Pinyin.WordsHelper.GetPinyin(string text, string splitSpan, bool tone)
         tone:false → 无声调，如 "Wen"；tone:true → 带声调，如 "Wēn"。
         返回首字母大写，故调用方须 ToLowerInvariant。
    -->
    <PackageReference Include="ToolGood.Words.Pinyin" Version="3.0.1.4" />
  </ItemGroup>
</Project>
