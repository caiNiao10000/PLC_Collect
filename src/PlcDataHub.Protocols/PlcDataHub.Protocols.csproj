<Project Sdk="Microsoft.NET.Sdk">
  <!-- 刻意不写 TargetFramework：由 Directory.Build.props 统一提供 net8.0-windows。
       ⚠️ 不要用 `dotnet new classlib -f net8.0` 生成：本机 .NET 10 SDK 的模板只暴露
          net10.0，传 net8.0 会以退出码 127 失败。正确做法是默认生成后手工删掉
          模板写入的 <TargetFramework> 行（本文件即如此），并由 Directory.Build.targets
          的 PLCDH001 护栏拦住任何漏删。 -->
  <PropertyGroup>
    <RootNamespace>PlcDataHub.Protocols</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--
      必须排除 tests 子目录。SDK 风格项目默认编译目录树下的所有 .cs；若将来有人把
      测试项目挪进本项目子目录，测试源码会被编进类库并报"未能找到类型或命名空间名
      Xunit"，而错误指向类库本身，极难排查。本机已实测。与 PlcDataHub.Core 保持一致。
    -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlcDataHub.Core\PlcDataHub.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- NModbus 3.0.83：Step 1 实测结论见 task-7-report.md。该包带 net6.0 目标，
         在 net8.0-windows 下由 NuGet 选中（不是 netstandard2.0 兼容路径），还原与运行均实测通过。 -->
    <PackageReference Include="NModbus" Version="3.0.83" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只对测试项目开放 internal：Modbus 的请求通道抽象（IModbusRequestChannel）刻意保持 internal，
         它是**可测性接缝**而不是公开 API。没有它，编排逻辑（按从站+区分组、位/寄存器两条读取路径、
         逐块故障隔离、地址校验）就只能靠真起 socket 才能测；有了它，这些断言不依赖网络。
         真实链路（NModbus + socket + 线路字节）另由 ModbusTcpWireTests 用手写 Modbus TCP 从站端到端覆盖。 -->
    <InternalsVisibleTo Include="PlcDataHub.Protocols.Tests" />
  </ItemGroup>
</Project>
